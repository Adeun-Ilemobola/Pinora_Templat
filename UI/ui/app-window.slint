import { Palette, VerticalBox } from "std-widgets.slint";
import { TopTabs } from "components/top-tabs.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { ModulesPage } from "pages/modules.slint";
import { PlaygroundPage } from "pages/playground.slint";
import { ConnectionTypeS, TransportTypeS } from "shared/types.slint";
import { Theme } from "shared/theme.slint";

// Re-exported types are intentionally part of the generated Rust interface.
export {
    ConnectionTypeS,
    ModuleTypeS,
    ModuleView,
    TransportTypeS,
} from "shared/types.slint";

export component AppWindow inherits Window {
    in-out property <int> current-tab: 0;

    in-out property <TransportTypeS> selected_transport;
    in property <[string]> combo-transport-model;
    in property <ConnectionTypeS> Connection_mode: ConnectionTypeS.Disconnected;

    in property <[string]> ports: [];
    in property <[string]> baudrates: [];
    in-out property <string> baudrate;
    in-out property <string> port;
    in-out property <string> wifi_ssid;
    in-out property <string> wifi_password;
    in-out property <string> bluetooth_name;
    in-out property <string> bluetooth_pin;

    in property <string> esp_idf_version;
    in property <string> total_heap;
    in property <string> current_free_heap;
    in property <string> lowest_free_heap;
    in property <string> largest_allocation;
    in property <string> maximum_app_slot;
    in property <string> flash_size;
    in property <int> registered_module_count: 0;
    in property <int> total_error_count: 0;

    callback request_Make_Connection();
    callback request_Make_Disconnect();

    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "Pinora";
    preferred-width: 1100px;
    preferred-height: 940px;
    min-width: 560px;
    min-height: 560px;
    background: Theme.background;

    VerticalBox {
        spacing: 0px;

        TopTabs {
            current-tab <=> root.current-tab;
        }

        if root.current-tab == 0: DashboardPage {
            selected-transport <=> root.selected_transport;
            transport-options: root.combo-transport-model;
            connection-mode: root.Connection_mode;
            ports: root.ports;
            baudrates: root.baudrates;
            baudrate <=> root.baudrate;
            port <=> root.port;
            wifi-ssid <=> root.wifi_ssid;
            wifi-password <=> root.wifi_password;
            bluetooth-name <=> root.bluetooth_name;
            bluetooth-pin <=> root.bluetooth_pin;

            esp-idf-version: root.esp_idf_version;
            total-heap: root.total_heap;
            free-heap: root.current_free_heap;
            lowest-free-heap: root.lowest_free_heap;
            largest-allocation: root.largest_allocation;
            maximum-app-slot: root.maximum_app_slot;
            flash-size: root.flash_size;
            registered-module-count: root.registered_module_count;
            total-error-count: root.total_error_count;

            connect-requested => { root.request_Make_Connection(); }
            disconnect-requested => { root.request_Make_Disconnect(); }
        }

        if root.current-tab == 1: ModulesPage {}
        if root.current-tab == 2: PlaygroundPage {}
    }
}
