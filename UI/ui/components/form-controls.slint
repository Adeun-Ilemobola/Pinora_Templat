import { ComboBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { Theme } from "../shared/theme.slint";

export component InputCore inherits VerticalBox {
    callback text-changed(string);

    in-out property <string> value: "";
    in property <string> placeholder: "";
    in property <string> label: "";
    in property <bool> disabled: false;
    in property <InputType> input-type: text;

    spacing: 6px;
    height: 64px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    min-width: 110px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 600;
        height: 20px;
        vertical-alignment: center;
    }

    LineEdit {
        text: root.value;
        placeholder-text: root.placeholder;
        enabled: !root.disabled;
        input-type: root.input-type;
        font-size: 15px;
        height: 38px;

        edited(text) => {
            root.text-changed(text);
        }
    }
}

export component SelectorCore inherits VerticalBox {
    callback selection-changed(string);

    in property <[string]> values: [];
    in property <string> label: "";
    in property <bool> disabled: false;

    spacing: 6px;
    height: 64px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    min-width: 110px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 600;
        height: 20px;
        vertical-alignment: center;
    }

    ComboBox {
        model: root.values;
        current-index: 0;
        enabled: !root.disabled;
        height: 38px;

        selected(value) => {
            root.selection-changed(value);
        }
    }
}
