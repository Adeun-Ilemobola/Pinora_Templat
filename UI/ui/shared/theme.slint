export global Theme {
    out property <color> background: #090d12;
    out property <color> surface: #111821;
    out property <color> surface-raised: #17212c;
    out property <color> border: #273442;
    out property <color> text: #f1f5f9;
    out property <color> text-muted: #91a0b2;
    out property <color> accent: #55b7ff;
    out property <color> accent-soft: #17344a;
}
