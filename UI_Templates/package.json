{
	"name": "UI_Templates",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:desktop": "electrobun dev",
		"dev:hmr": "concurrently --kill-others-on-fail \"bun run hmr\" \"bun run dev:desktop\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/merriweather": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.2.3",
		"@hugeicons/react": "^1.1.9",
		"@phosphor-icons/react": "phosphor-icons/react",
		"bun-serialport": "^0.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"electrobun": "1.18.1",
		"lucide-react": "^1.27.0",
		"next-themes": "^0.4.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.18.1",
		"recharts": "^3.10.1",
		"serialport": "^13.0.0",
		"shadcn": "^4.15.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
